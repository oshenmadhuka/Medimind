# MediMind Environment Variables
# Copy this to .env and fill in your values

# ── LLM Provider ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Model options: llama-3.3-70b-versatile | mixtral-8x7b-32768 | llama3-8b-8192
GROQ_MODEL=llama-3.3-70b-versatile

# ── LangSmith (Observability) ────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=medimind-clinical-ai

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://medimind:medimind123@localhost:5432/medimind_db

# ── App Config ───────────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Vector Store ─────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=medical_literature

# ── External APIs ────────────────────────────────
OPENFDA_API_KEY=your_openfda_key_here   # optional, works without it too
